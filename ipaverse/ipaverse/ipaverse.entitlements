<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by the SAP (Sign App Store Protocol) x86-64 emulator —
	     Unicorn Engine (statically linked, see Vendor/unicorn/) allocates
	     RWX pages at runtime to run the emulated Apple FairPlay/CommerceKit
	     code. App Sandbox is not enabled in this project, so these are
	     additive under Hardened Runtime only. No disable-library-validation
	     entitlement is needed since Unicorn is statically linked, not a
	     separately-signed dylib. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
